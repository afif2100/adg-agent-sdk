[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_name }} — an ADG-compliant project"
readme = "README.md"
requires-python = "{{ python_version }}"
license = { text = "MIT" }

authors = [
  { name = "Your Name", email = "you@example.com" },
]

dependencies = []

[project.urls]
Homepage = "https://github.com/your-org/{{ project_name }}"
Source = "https://github.com/your-org/{{ project_name }}"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
    "ruff>=0.5",
    "mypy>=1.10",
]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-v --tb=short"

[tool.ruff]
target-version = "py311"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "ANN", "ARG", "B", "C4", "SIM"]

[tool.mypy]
strict = true
python_version = "3.11"
files = ["src/{{ package_name }}"]
